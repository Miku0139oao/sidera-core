ARG BASE_IMAGE=alpine
FROM ${BASE_IMAGE}
ARG TARGETARCH
ARG TARGETVARIANT
LABEL maintainer="Miku0139oao"
RUN set -ex \
    && if command -v apk > /dev/null; then \
        apk add --no-cache --upgrade bash tzdata ca-certificates nftables; \
    else \
        apt-get update && apt-get install -y --no-install-recommends bash tzdata ca-certificates nftables \
        && rm -rf /var/lib/apt/lists/*; \
    fi
COPY sidera-${TARGETARCH}${TARGETVARIANT} /usr/local/bin/sidera
COPY LICENSE /usr/share/licenses/sidera/LICENSE
COPY release/licenses/ /usr/share/licenses/sidera/third-party/
COPY NOTICE.md UPSTREAM.md sidera.buildinfo /usr/share/doc/sidera/
ENTRYPOINT ["sidera"]
