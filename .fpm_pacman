-s dir
--name sidera
--category net
--license GPL-3.0-or-later
--description "Single-data-plane universal proxy core."
--url "https://github.com/Miku0139oao/sidera-core"
--maintainer "Miku0139oao <62833794+Miku0139oao@users.noreply.github.com>"
--config-files etc/sidera/config.json
--after-install release/config/sidera.postinst

release/config/config.json=/etc/sidera/config.json

release/config/sidera.service=/usr/lib/systemd/system/sidera.service
release/config/sidera@.service=/usr/lib/systemd/system/sidera@.service
release/config/sidera.sysusers=/usr/lib/sysusers.d/sidera.conf
release/config/sidera.rules=/usr/share/polkit-1/rules.d/sidera.rules
release/config/sidera-split-dns.xml=/usr/share/dbus-1/system.d/sidera-split-dns.conf

release/completions/sidera.bash=/usr/share/bash-completion/completions/sidera.bash
release/completions/sidera.fish=/usr/share/fish/vendor_completions.d/sidera.fish
release/completions/sidera.zsh=/usr/share/zsh/site-functions/_sidera

LICENSE=/usr/share/licenses/sidera/LICENSE
